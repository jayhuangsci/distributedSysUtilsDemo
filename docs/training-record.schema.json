{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayhuangsci/distributedSysUtilsDemo/blob/master/docs/training-record.schema.json",
  "title": "Hadoop Corpus Pipeline training chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "document_id", "text", "tokens", "token_count", "tokenizer", "split", "chunk_index", "token_start", "token_end", "source_occurrences", "source", "document_redactions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "tokens": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "token_count": {"type": "integer", "minimum": 1},
    "tokenizer": {"const": "unicode-lexical-v1"},
    "split": {"enum": ["train", "validation"]},
    "chunk_index": {"type": "integer", "minimum": 0},
    "token_start": {"type": "integer", "minimum": 0},
    "token_end": {"type": "integer", "minimum": 1},
    "source_occurrences": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "offset"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "offset": {"type": "integer", "minimum": 0}
      }
    },
    "document_redactions": {
      "type": "object", "additionalProperties": false, "required": ["email", "phone", "ip", "card", "url"],
      "properties": {
        "email": {"type": "integer", "minimum": 0},
        "phone": {"type": "integer", "minimum": 0},
        "ip": {"type": "integer", "minimum": 0},
        "card": {"type": "integer", "minimum": 0},
        "url": {"type": "integer", "minimum": 0}
      }
    }
  }
}
